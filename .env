REACT_APP_WEBSITE_NAME=Shooot
# npm 7+ only exposes npm_package_name and npm_package_version to scripts,
# so the other values are written out here
REACT_APP_WEBSITE_DESCRIPTION=Free Dribbble shots generator
REACT_APP_WEBSITE_VERSION=${npm_package_version}
REACT_APP_WEBSITE_REPOSITORY=https://github.com/bourhaouta/shooot
REACT_APP_WEBSITE_URL=https://shooot.bourhaouta.com
REACT_APP_OWNER_USERNAME=bourhaouta
